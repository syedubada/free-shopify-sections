            <span class="wsp-bundle-tier-label-{{ wsp_gen_id }}">{{ section.settings.tier_3_name }}</span>
            <span class="wsp-bundle-tier-discount-{{ wsp_gen_id }}">{{ section.settings.tier_3_discount }}% OFF</span>
          </div>
